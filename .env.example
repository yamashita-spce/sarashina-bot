# Sarashina API key (issue at https://chat.sarashina.ai/dashboard/api-keys)
SARASHINA_API_KEY=
# Discord bot token (Discord Developer Portal > Bot > Token)
DISCORD_BOT_TOKEN=
# Channel IDs where the bot replies (comma-separated)
DISCORD_CHANNEL_IDS=
# Optional settings
SARASHINA_MODEL=sarashina3-mini
SARASHINA_MAX_COMPLETION_TOKENS=2000
SARASHINA_TEMPERATURE=0.7
# Requests per minute (beta limits: mini=6, nano=60)
SARASHINA_RPM=6
SYSTEM_PROMPT=あなたはDiscordサーバーで皆の質問に答える親切なアシスタントです。簡潔かつ正確に日本語で回答してください。
# How many earlier messages in a reply chain to include as context
HISTORY_LIMIT=10

# --- Channel context (summarize recent conversation and add it to the prompt) ---
CONTEXT_ENABLED=true
# Model used for summarizing (nano allows 60 RPM, so it does not eat the mini quota)
CONTEXT_MODEL=sarashina3-nano
# Number of messages to read on first summary after startup
CONTEXT_FETCH_LIMIT=50
# Number of latest raw messages included verbatim alongside the summary
CONTEXT_RECENT_MESSAGES=5
# Target max length of the summary (characters)
CONTEXT_SUMMARY_CHARS=600

# --- Thinking (nano thinks in stages in the backend; Discord shows only an animated status line) ---
# Off by default (A/B test showed little gain over mini alone)
THINKING_ENABLED=false
# true = prefix the answer with a "💭 X秒 考えました" line (only when thinking is enabled)
THINKING_KEEP=false
THINKING_MODEL=sarashina3-nano
THINKING_MAX_CHARS=800
# Minimum seconds the thinking animation runs (spent thinking)
THINKING_MIN_SECONDS=4
# If the mini slot is at least this many seconds away, add an "answer plan" pass
THINKING_PLAN_MIN_WAIT=3
# Seconds between status-animation edits
STREAM_EDIT_INTERVAL=1.2

# --- Channel-wide search ---
SEARCH_ENABLED=true
# Channel IDs to index (empty = every text channel the bot can read)
SEARCH_CHANNEL_IDS=
# Max results for "where was X discussed" searches
SEARCH_RESULTS=5
# Max past messages to backfill per channel
SEARCH_BACKFILL_LIMIT=5000
# Seconds between indexing cycles
SEARCH_INDEX_INTERVAL=120

# --- Logging (logs/bot.log, rotated daily) ---
LOG_RETENTION_DAYS=7
LOG_LEVEL=INFO
