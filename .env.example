# Sarashina API key (issue at https://chat.sarashina.ai/dashboard/api-keys)
SARASHINA_API_KEY=
# Discord bot token (Discord Developer Portal > Bot > Token)
DISCORD_BOT_TOKEN=
# Channel IDs where the bot replies (comma-separated)
DISCORD_CHANNEL_IDS=
# Optional settings
SARASHINA_MODEL=sarashina3-mini
SARASHINA_MAX_COMPLETION_TOKENS=2000
SARASHINA_TEMPERATURE=0.5
# Requests per minute (beta limits: mini=6, nano=60)
SARASHINA_RPM=6
# Leave empty to use the built-in prompt (answer first, no stock phrases, follow the recent conversation)
SYSTEM_PROMPT=
# How many earlier messages in a reply chain to include as context
HISTORY_LIMIT=10

# --- Channel context (summarize recent conversation and add it to the prompt) ---
CONTEXT_ENABLED=true
# Model used for summarizing (nano allows 60 RPM, so it does not eat the mini quota)
CONTEXT_MODEL=sarashina3-nano
# Number of messages to read on first summary after startup
CONTEXT_FETCH_LIMIT=50
# Number of latest messages passed verbatim as conversation turns
CONTEXT_RECENT_MESSAGES=12
# Target max length of the summary (characters)
CONTEXT_SUMMARY_CHARS=600

# --- Thinking (nano thinks in stages in the backend; Discord shows only an animated status line) ---
# On by default (quality over speed)
THINKING_ENABLED=true
# nano checks mini's draft; mini rewrites once only if a serious problem is found
ANSWER_CHECK_ENABLED=true
# true = prefix the answer with a "💭 X秒 考えました" line (only when thinking is enabled)
THINKING_KEEP=false
THINKING_MODEL=sarashina3-nano
THINKING_MAX_CHARS=800
# Minimum seconds the thinking animation runs (spent thinking)
THINKING_MIN_SECONDS=4
# If the mini slot is at least this many seconds away, add an "answer plan" pass
THINKING_PLAN_MIN_WAIT=3
# Seconds between status-animation edits
STREAM_EDIT_INTERVAL=1.2

# --- Channel-wide search ---
SEARCH_ENABLED=true
# Channel IDs to index (empty = every text channel the bot can read)
SEARCH_CHANNEL_IDS=
# Max results for "where was X discussed" searches
SEARCH_RESULTS=5
# Max past messages to backfill per channel / max age in days
SEARCH_BACKFILL_LIMIT=5000
SEARCH_BACKFILL_DAYS=365
# Searches without a date range look back this many days first (falls back to all time)
SEARCH_DEFAULT_DAYS=365
# Search rounds (min/max). The bot keeps searching until nano judges the info sufficient
SEARCH_MIN_ROUNDS=2
SEARCH_MAX_ROUNDS=6
# Number of answer drafts mini writes in one request (n) for nano to judge, and whether to refine once
ANSWER_CANDIDATES=3
ANSWER_REFINE_ENABLED=true
# Rounds of the persistent search run before the bot ever asks the user to clarify
SEARCH_EXHAUSTIVE_ROUNDS=5
# Also index the bot's own channels (off: questions to the bot pollute results)
SEARCH_INDEX_BOT_CHANNELS=false
# Max results from the same author per search
SEARCH_MAX_PER_AUTHOR=2
# Use related past conversations when answering ordinary questions (RAG)
RAG_ENABLED=true
# Seconds between crawl cycles (catch-up and backfill; new messages are indexed in real time)
SEARCH_INDEX_INTERVAL=120

# --- Logging (logs/bot.log, rotated daily) ---
LOG_RETENTION_DAYS=7
LOG_LEVEL=INFO
